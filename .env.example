# Copy to .env to change settings. Everything is optional.
PORT=3000
# Real admin account (use these when you go live; then there is no sample data)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
# Secret used to sign login tokens. Leave empty: one is generated and saved in data/.secret_key
SECRET_KEY=
# 1 = load sample data and demo accounts, 0 = start empty. Default: 1 for `npm run dev`, 0 for `npm start`
SEED_DEMO=
DEMO_PASSWORD=Demo@12345
TZ_NAME=Asia/Kolkata
# Set to 1 only when running behind a reverse proxy (nginx, Caddy...)
TRUST_PROXY=0
