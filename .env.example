# Copy to .env to change settings. Everything is optional.
PORT=3000
# Real admin account (use these when you go live; then there is no sample data)
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
# Secret used to sign login tokens. Leave empty: one is generated and saved in data/.secret_key
SECRET_KEY=
# 1 = load sample data and demo accounts, 0 = start empty. Default: 1 for `npm run dev`, 0 for `npm start`
SEED_DEMO=
DEMO_PASSWORD=Demo@12345
TZ_NAME=Asia/Kolkata
# Set to 1 only when running behind a reverse proxy (nginx, Caddy...)
TRUST_PROXY=0

# Production mode — set to 'production' to disable demo fallback and enable HSTS
NODE_ENV=development

# CORS — comma-separated allowed origins; use '*' for dev only, your domain in prod
# CORS_ORIGINS=https://yourdomain.com

# Payment gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourdomain.com

# WhatsApp Business Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS (MSG91 / Fast2SMS)
SMS_API_KEY=
SMS_SENDER_ID=NRITYA

# Database backups
BACKUP_RETAIN_DAYS=30
